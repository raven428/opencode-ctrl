 const log = Log.create({ service: "mcp" })
 const DEFAULT_TIMEOUT = 30_000
+const RECONNECT_INITIAL_DELAY = 1_000
+const RECONNECT_MAX_DELAY = 11_000
+const RECONNECT_STEP_ATTEMPTS = 3
+const RECONNECT_CYCLE = 36
+const LIST_TOOLS_TTL = 60 * 60 * 1000
+
+function reconnectDelay(attempt: number): number {
+  const effectiveAttempt = ((attempt - 1) % RECONNECT_CYCLE) + 1
+  return Math.min(
+    (Math.floor((effectiveAttempt - 1) / RECONNECT_STEP_ATTEMPTS) + 1) * RECONNECT_INITIAL_DELAY,
+    RECONNECT_MAX_DELAY,
+  )
+}
+
+function isSessionExpired(error: unknown): boolean {
+  if (!error) return false
+  const message = error instanceof Error ? error.message : String(error)
+  if (/session terminated|session expired|invalid session|session not found/i.test(message)) return true
+  if (/\bHTTP\s+404\b/i.test(message)) return true
+  const value = error as { code?: unknown; status?: unknown; statusCode?: unknown }
+  return [value.code, value.status, value.statusCode].some((item) => item === 404)
+}
+
+function reconnectReason(error: unknown): "sessionExpired" | "networkError" | "rateLimit" | "unknown" {
+  if (isSessionExpired(error)) return "sessionExpired"
+  const message = error instanceof Error ? error.message : String(error)
+  if (/rate.?limit|too many requests|429/i.test(message)) return "rateLimit"
+  if (/timeout|timed out|econnrefused|enotfound|eai_again|fetch failed|network/i.test(message)) return "networkError"
+  return "unknown"
+}
 
