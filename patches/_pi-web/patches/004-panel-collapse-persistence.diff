+export function readStoredPanelCollapse(storage: PanelCollapseStorage | undefined = browserPanelCollapseStorage()): PanelCollapsePreferences {
+  try {
+    const raw = storage?.getItem(PANEL_COLLAPSE_STORAGE_KEY);
+    if (raw === undefined || raw === null || raw === "") return {};
+    const value: unknown = JSON.parse(raw);
+    const parsed = parseStoredPanelCollapse(value);
+    if (parsed === undefined) {
+      storage?.removeItem(PANEL_COLLAPSE_STORAGE_KEY);
+      return {};
+    }
+    return parsed;
+  } catch {
+    return {};
+  }
+}
+
+export function writeStoredPanelCollapse(preferences: PanelCollapsePreferences, storage: PanelCollapseStorage | undefined = browserPanelCollapseStorage()): void {
+  if (storage === undefined) return;
+  try {
+    const current = readStoredPanelCollapse(storage);
+    const merged: PanelCollapsePreferences = { ...current, ...preferences };
+    const envelope: StoredPanelCollapseEnvelope = { version: 1 };
+    if (merged.navigationPanelCollapsed !== undefined) envelope.navigationPanelCollapsed = merged.navigationPanelCollapsed;
+    if (merged.workspacePanelCollapsed !== undefined) envelope.workspacePanelCollapsed = merged.workspacePanelCollapsed;
+    if (merged.navigationSections !== undefined) envelope.navigationSections = merged.navigationSections;
+    if (merged.archivedSessionsExpanded !== undefined) envelope.archivedSessionsExpanded = merged.archivedSessionsExpanded;
+    storage.setItem(PANEL_COLLAPSE_STORAGE_KEY, JSON.stringify(envelope));
+  } catch {
+    // Ignore localStorage quota/privacy errors; the collapse state still applies in memory for this tab.
+  }
+}
+
+/** Returns undefined for a malformed envelope (not an object, wrong version, or non-boolean fields) so the caller can drop the stale key instead of trusting partial data. */
+function parseStoredPanelCollapse(value: unknown): PanelCollapsePreferences | undefined {
+  if (!isRecord(value) || value["version"] !== 1) return undefined;
+  const preferences: PanelCollapsePreferences = {};
+  for (const key of ["navigationPanelCollapsed", "workspacePanelCollapsed", "archivedSessionsExpanded"] as const) {
+    const field = value[key];
+    if (field === undefined) continue;
+    if (typeof field !== "boolean") return undefined;
+    preferences[key] = field;
+  }
+  const navigationSections = value["navigationSections"];
+  if (navigationSections !== undefined) {
+    if (!Array.isArray(navigationSections) || !navigationSections.every((section): section is string => typeof section === "string")) return undefined;
+    preferences.navigationSections = navigationSections;
+  }
+  return preferences;
+}
+
+function browserPanelCollapseStorage(): PanelCollapseStorage | undefined {
+  try {
+    if (typeof window === "undefined") return undefined;
+    return window.localStorage;
+  } catch {
+    return undefined;
+  }
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null;
+}
