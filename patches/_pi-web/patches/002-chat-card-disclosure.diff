--- a/src/client/src/chatDisclosureModes.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/client/src/chatDisclosureModes.ts	2026-09-18 15:47:25.029961440 +0000
@@ -0,0 +1,89 @@
+import type { PiWebDisclosureConfig, PiWebDisclosureMode, PiWebGroupDisclosureMode } from "./api";
+import type { ChatGroup } from "./chatGroups";
+import type { ChatPart } from "./components/shared";
+
+export type PiWebPartDisclosureKind = Exclude<keyof PiWebDisclosureConfig, "eventsGroup">;
+
+export const DEFAULT_CHAT_DISCLOSURE_MODES: Required<PiWebDisclosureConfig> = {
+  thinking: "none",
+  skillInvocation: "none",
+  toolResult: "none",
+  toolDetails: "none",
+  toolDiff: "all",
+  eventsGroup: "live",
+};
+
+export function chatDisclosureMode(config: PiWebDisclosureConfig, kind: PiWebPartDisclosureKind): PiWebDisclosureMode {
+  return config[kind] ?? DEFAULT_CHAT_DISCLOSURE_MODES[kind];
+}
+
+export function chatCardKey(messageIndex: number, partIndex: number): string {
+  return `${String(messageIndex)}:${String(partIndex)}`;
+}
+
+/** The disclosure kinds one transcript part can render a card for. */
+export function partDisclosureKinds(part: ChatPart): PiWebPartDisclosureKind[] {
+  if (part.type === "thinking") return ["thinking"];
+  if (part.type === "skillInvocation") return ["skillInvocation"];
+  if (part.type === "toolExecution") return ["toolDetails", "toolDiff", "toolResult"];
+  if (part.type === "toolResult") return ["toolResult"];
+  return [];
+}
+
+/** The last card of every kind in render order, which `last` and `live` target. */
+export function lastDisclosureCards(groups: ChatGroup[]): Map<PiWebPartDisclosureKind, string> {
+  const lastCards = new Map<PiWebPartDisclosureKind, string>();
+  const visit = (parts: ChatPart[], messageIndex: number) => {
+    parts.forEach((part, partIndex) => {
+      for (const kind of partDisclosureKinds(part)) lastCards.set(kind, chatCardKey(messageIndex, partIndex));
+    });
+  };
+  for (const group of groups) {
+    if (group.kind !== "group") {
+      visit(group.message.parts, group.index);
+      continue;
+    }
+    group.messages.forEach((message, offset) => { visit(message.parts, group.startIndex + offset); });
+  }
+  return lastCards;
+}
+
+export interface ChatCardOpenOptions {
+  config: PiWebDisclosureConfig;
+  kind: PiWebPartDisclosureKind;
+  isLastCard: boolean;
+  isSessionLive: boolean;
+  forceOpen?: boolean;
+}
+
+export function chatCardOpen(options: ChatCardOpenOptions): boolean {
+  if (options.forceOpen === true) return true;
+  const mode = chatDisclosureMode(options.config, options.kind);
+  if (mode === "all") return true;
+  if (mode === "last") return options.isLastCard;
+  if (mode === "live") return options.isLastCard && options.isSessionLive;
+  return false;
+}
+
+export function eventsGroupDisclosureMode(config: PiWebDisclosureConfig): PiWebGroupDisclosureMode {
+  return config.eventsGroup ?? DEFAULT_CHAT_DISCLOSURE_MODES.eventsGroup;
+}
+
+/** Position of the last events group; -1 when the transcript has none. */
+export function lastEventsGroupIndex(groups: ChatGroup[]): number {
+  let lastIndex = -1;
+  groups.forEach((group, index) => { if (group.kind === "group") lastIndex = index; });
+  return lastIndex;
+}
+
+export interface GroupDisclosureOpenOptions {
+  mode: PiWebGroupDisclosureMode;
+  isLastGroup: boolean;
+  isSessionLive: boolean;
+}
+
+export function groupDisclosureOpen(options: GroupDisclosureOpenOptions): boolean {
+  if (options.mode === "all") return true;
+  if (options.mode === "last") return options.isLastGroup;
+  return options.isLastGroup && options.isSessionLive;
+}
