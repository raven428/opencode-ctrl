--- a/src/client/src/chatDisclosureModes.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/client/src/chatDisclosureModes.ts	2026-09-18 12:02:12.409835292 +0000
@@ -0,0 +1,31 @@
+import type { PiWebDisclosureConfig, PiWebDisclosureMode } from "./api";
+
+export const DEFAULT_CHAT_DISCLOSURE_MODES: Required<PiWebDisclosureConfig> = {
+  thinking: "none",
+  skillInvocation: "none",
+  toolResult: "none",
+  toolDetails: "none",
+  toolDiff: "all",
+};
+
+export function chatDisclosureMode(config: PiWebDisclosureConfig, kind: keyof PiWebDisclosureConfig): PiWebDisclosureMode {
+  return config[kind] ?? DEFAULT_CHAT_DISCLOSURE_MODES[kind];
+}
+
+export interface ChatCardOpenOptions {
+  config: PiWebDisclosureConfig;
+  kind: keyof PiWebDisclosureConfig;
+  index: number;
+  lastRenderedIndex: number;
+  isSessionLive: boolean;
+  forceOpen?: boolean;
+}
+
+export function chatCardOpen(options: ChatCardOpenOptions): boolean {
+  if (options.forceOpen === true) return true;
+  const mode = chatDisclosureMode(options.config, options.kind);
+  if (mode === "all") return true;
+  if (mode === "live") return options.isSessionLive;
+  if (mode === "last") return options.index >= options.lastRenderedIndex;
+  return false;
+}
