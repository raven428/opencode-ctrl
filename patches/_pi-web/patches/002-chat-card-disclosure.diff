+const DISCLOSURE_MODES = ["none", "live", "last", "all"] as const satisfies readonly PiWebDisclosureMode[];
+const DISCLOSURE_KEYS = ["thinking", "skillInvocation", "toolResult", "toolDetails", "toolDiff"] as const satisfies readonly Exclude<keyof PiWebDisclosureConfig, "eventsGroup">[];
+const GROUP_DISCLOSURE_MODES = ["live", "last", "all"] as const satisfies readonly PiWebGroupDisclosureMode[];
+
+function optionalUi(value: unknown): PiWebUiConfig | undefined {
+  if (value === undefined) return undefined;
+  if (!isRecord(value) || Array.isArray(value)) throw new Error("Invalid PI WEB ui field");
+  for (const key of Object.keys(value)) {
+    if (key !== "disclosure") throw new Error("Invalid PI WEB ui field");
+  }
+  const disclosure = value["disclosure"];
+  return {
+    ...optionalField("disclosure", optionalDisclosure(disclosure)),
+  };
+}
+
+function optionalDisclosure(value: unknown): PiWebDisclosureConfig | undefined {
+  if (value === undefined) return undefined;
+  if (!isRecord(value) || Array.isArray(value)) throw new Error("Invalid PI WEB ui field");
+  const result: PiWebDisclosureConfig = {};
+  for (const [key, mode] of Object.entries(value)) {
+    if (key === "eventsGroup") {
+      if (!GROUP_DISCLOSURE_MODES.includes(mode as typeof GROUP_DISCLOSURE_MODES[number])) throw new Error("Invalid PI WEB ui field");
+      result.eventsGroup = mode as PiWebGroupDisclosureMode;
+      continue;
+    }
+    if (!DISCLOSURE_KEYS.includes(key as typeof DISCLOSURE_KEYS[number])) throw new Error("Invalid PI WEB ui field");
+    if (!DISCLOSURE_MODES.includes(mode as typeof DISCLOSURE_MODES[number])) throw new Error("Invalid PI WEB ui field");
+    result[key as typeof DISCLOSURE_KEYS[number]] = mode as PiWebDisclosureMode;
+  }
+  return result;
+}
+
 function optionalPlugins(value: unknown): PiWebPluginConfigMap | undefined {
