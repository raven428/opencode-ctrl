+
+function parseDisclosureRequest(value: unknown): PiWebDisclosureConfig {
+  if (!isRecord(value)) throw new Error("PI WEB config ui.disclosure must be an object");
+  const result: PiWebDisclosureConfig = {};
+  for (const [key, mode] of Object.entries(value)) {
+    if (key === "eventsGroup") {
+      if (!GROUP_DISCLOSURE_MODES.includes(mode as typeof GROUP_DISCLOSURE_MODES[number])) {
+        throw new Error(`PI WEB config ui.disclosure.eventsGroup must be one of ${GROUP_DISCLOSURE_MODES.join(", ")}`);
+      }
