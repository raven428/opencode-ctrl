+    if (!DISCLOSURE_KEYS.includes(key as typeof DISCLOSURE_KEYS[number])) {
+      throw new Error(`PI WEB config ui.disclosure key is not allowed: ${key}`);
+    }
+    if (!DISCLOSURE_MODES.includes(mode as typeof DISCLOSURE_MODES[number])) {
+      throw new Error(`PI WEB config ui.disclosure.${key} must be one of ${DISCLOSURE_MODES.join(", ")}`);
+    }
+    result[key as typeof DISCLOSURE_KEYS[number]] = mode as PiWebDisclosureMode;
+  }
+  return result;
